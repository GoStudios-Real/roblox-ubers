# Copy this file to .env and fill in your own keys. NEVER commit .env.

# Server
PORT=3000
BASE_URL=http://localhost:3000
# Allow the published GitHub Pages site to call this server through Cloudflare Tunnel.
CORS_ORIGINS=https://gostudios-real.github.io
# Roblox game servers require this app to be deployed at a public HTTPS URL.
# Shared secret the Roblox place script sends with each player/vehicle ping.
TRACKING_TOKEN=

# OpenRouter (AI support chat)  https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Stripe (payments) https://dashboard.stripe.com/apikeys
# Publishable key is safe for browser use; hosted Checkout below still needs the
# private secret key. Use test keys while developing.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd

# Roblox Open Cloud API key  https://create.roblox.com/dashboard/credentials
# (scope: e.g. universes.read, datastore.read)
ROBLOX_API_KEY=
ROBLOX_UBERS_UNIVERSE_ID_BROOKHAVEN=
# Required to enable Roblox stats, game join links, and NPC dispatch. Create
# original places you own, then enter their numeric place IDs here. Official
# third-party games are intentionally not used as fallbacks.
ROBLOX_UBERS_PLACE_ID_BROOKHAVEN=
ROBLOX_UBERS_PLACE_ID_BLOXBURG=
# Optional display names for the original places (used in bookings, maps, and Roblox API).
ROBLOX_UBERS_GAME_NAME_BROOKHAVEN=
ROBLOX_UBERS_GAME_NAME_BLOXBURG=
