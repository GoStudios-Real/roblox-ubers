# Copy this file to .env and fill in your own keys. NEVER commit .env.

# Server
PORT=3000
BASE_URL=http://localhost:3000
# Allow the published GitHub Pages site to call this server through Playit.
CORS_ORIGINS=https://gostudios-real.github.io
# Set true to start your already-claimed Playit agent when this server starts.
PLAYIT_AUTOSTART=false
# For example: C:\Program Files\playit_gg\bin\playit.exe
PLAYIT_EXECUTABLE=playit.exe
# Roblox game servers require this app to be deployed at a public HTTPS URL.
# Shared secret the Roblox place script sends with each player/vehicle ping.
TRACKING_TOKEN=

# OpenRouter (AI support chat)  https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Stripe (payments)  https://dashboard.stripe.com/apikeys  -- use TEST keys (sk_test_...) while developing
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd

# Roblox Open Cloud API key  https://create.roblox.com/dashboard/credentials
# (scope: e.g. universes.read, datastore.read)
ROBLOX_API_KEY=
ROBLOX_UNIVERSE_ID_BROOKHAVEN=
ROBLOX_UNIVERSE_ID_BLOXBURG=
