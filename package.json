{
  "name": "roblox-ubers",
  "version": "1.6.0",
  "description": "ROBLOX UBERS - Roblox roleplay ride bookings, timetables, live game data and support",
  "main": "server.js",
  "directories": {
    "doc": "docs",
    "lib": "lib"
  },
  "scripts": {
    "test": "node scripts/smoke.js",
    "build:pages": "node scripts/build-pages.js",
    "package:exe": "pkg server.js --public --targets node22.22.3-win-x64 --output dist/ROBLOX-UBERS-v1.6.0.exe",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "always-online": "powershell -ExecutionPolicy Bypass -File scripts/always-online.ps1",
    "scan:secrets": "node scripts/secret-scan.js",
    "key:status": "node scripts/key-status.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.6.0"
  },
  "overrides": {
    "@yao-pkg/pkg-fetch": "3.6.3",
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "lib/**/*"
    ]
  }
}
